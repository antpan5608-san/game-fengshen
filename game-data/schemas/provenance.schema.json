{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "records": {
      "items": {
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "originalVerified": {
                  "const": true
                }
              }
            },
            "then": {
              "properties": {
                "confidence": {
                  "const": "VERIFIED"
                },
                "evidenceRefs": {
                  "minItems": 1
                }
              }
            }
          }
        ],
        "properties": {
          "confidence": {
            "enum": [
              "VERIFIED",
              "HIGH",
              "MEDIUM",
              "LOW",
              "UNKNOWN"
            ]
          },
          "evidenceRefs": {
            "items": {
              "pattern": "^[a-z][a-z0-9_.-]{1,95}$",
              "type": "string"
            },
            "type": "array"
          },
          "id": {
            "pattern": "^[a-z][a-z0-9_.-]{1,95}$",
            "type": "string"
          },
          "licenseStatus": {
            "enum": [
              "UNKNOWN",
              "RESTRICTED",
              "PERMITTED"
            ]
          },
          "locator": {
            "additionalProperties": false,
            "properties": {
              "bank": {
                "minimum": 0,
                "type": "integer"
              },
              "column": {
                "type": "string"
              },
              "commit": {
                "type": "string"
              },
              "length": {
                "minimum": 0,
                "type": "integer"
              },
              "meaning": {
                "type": "string"
              },
              "offset": {
                "minimum": 0,
                "type": "integer"
              },
              "path": {
                "type": "string"
              },
              "primaryKey": {
                "type": [
                  "integer",
                  "string"
                ]
              },
              "repository": {
                "type": "string"
              },
              "romSha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              "sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              "table": {
                "type": "string"
              },
              "timestampMs": {
                "minimum": 0,
                "type": "integer"
              },
              "url": {
                "type": "string"
              }
            },
            "required": [],
            "type": "object"
          },
          "note": {
            "type": "string"
          },
          "originalVerified": {
            "type": "boolean"
          },
          "source": {
            "enum": [
              "ORIGINAL_ROM",
              "REFERENCE_PROJECT",
              "GAMEPLAY_VERIFIED",
              "GUIDE",
              "VIDEO",
              "MANUAL",
              "INFERRED",
              "UNKNOWN"
            ]
          }
        },
        "required": [
          "id",
          "source",
          "confidence",
          "originalVerified",
          "licenseStatus",
          "locator",
          "evidenceRefs",
          "note"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "schemaVersion": {
      "const": 1
    }
  },
  "required": [
    "schemaVersion",
    "records"
  ],
  "type": "object"
}
